# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build output
.next/
out/
dist/

# Environment & secrets
.env
.env.local
.env*.local

# Databases (local dev artifacts)
*.db
*.db-journal
*.sqlite3

# Benchmark artifacts (regenerated locally; results are committed)
bench_stw.db
backend/bench/uploads/

# Logs
*.log

# Upload *data* dirs — user files written under settings.upload_dir.
# Anchored on purpose. The previous bare `uploads/` matched every directory of
# that name at any depth, which silently swallowed source directories: the Next
# route folder app/src/app/api/uploads could not be added, so a fix living there
# would be invisible to git and to CI.
/uploads/
/backend/uploads/
/app/uploads/
/backend/bench/uploads/

# Edge/browser profiles
.edge-profile/

# OS
.DS_Store
Thumbs.db
nul

# IDE
.idea/
.vscode/
.claude/
.agents/

# Test artifacts
cookies*.txt
register.json
e2e-debug*.mjs
test_stw*.db
test-results/
playwright-report/

# Coverage artifacts (TA6-3): produced by pytest --cov in CI and locally.
.coverage
coverage.xml
htmlcov/

# Linked worktrees used for isolated verification runs. They are checkouts of
# this same repo, so tracking them makes git treat them as embedded repos (a
# stray gitlink got committed once already). A repo-root `ruff check .` also
# walks them and reports 146 phantom errors.
.worktrees/

# Agent scratch directory (task briefs, hand-off reports, review notes). It sits
# beside the code but is not part of it: tracking it puts working noise into every
# diff, and a reviewer cannot tell the change from the paperwork about the change.
.superpowers/
