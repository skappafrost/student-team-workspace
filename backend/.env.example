# PostgreSQL configuration
POSTGRES_USER=stw_user
POSTGRES_PASSWORD=stw_password
POSTGRES_DB=stw_db
POSTGRES_PORT=5432

# Backend database connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=stw_user
DB_PASSWORD=stw_password
DB_NAME=stw_db

# Full database URL (optional; docker-compose builds it automatically from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB when left unset)
# DATABASE_URL=postgresql+psycopg2://stw_user:stw_password@postgres:5432/stw_db

# Backend server
BACKEND_PORT=8000

# Runtime mode. Anything other than test/dev is treated as production by the
# startup guard in app.py, which then refuses the default JWT_SECRET_KEY below.
# This whole file is a development configuration: copying it to .env and starting
# a real server with it is exactly what the guard exists to stop.
#   test | dev | (unset/anything else = production)
ENVIRONMENT=dev

# Auth / security — REQUIRED in production: startup aborts while this is the
# default/blank and ENVIRONMENT is not test/dev (TA1-2). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=super-secret-change-me-in-production
COOKIE_SECURE=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Per-workspace storage quota in MB (0 disables the check)
MAX_WORKSPACE_STORAGE_MB=512
