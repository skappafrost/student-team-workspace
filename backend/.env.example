# PostgreSQL configuration
POSTGRES_USER=stw_user
POSTGRES_PASSWORD=stw_password
POSTGRES_DB=stw_db
POSTGRES_PORT=5432

# Backend database connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=stw_user
DB_PASSWORD=stw_password
DB_NAME=stw_db

# Full database URL (optional; docker-compose builds it automatically from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB when left unset)
# DATABASE_URL=postgresql://stw_user:stw_password@postgres:5432/stw_db

# Backend server
BACKEND_PORT=8000

# Auth / security (change JWT_SECRET_KEY in production!)
JWT_SECRET_KEY=super-secret-change-me-in-production
COOKIE_SECURE=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
